# ---------------------------------------------------------------------------
# Plantilla de variables de entorno para DESARROLLO LOCAL.
# Copie este archivo como `.env` y ajuste los valores.
#
# En AWS Elastic Beanstalk:
#   * Base de datos ACOPLADA al ambiente -> NO defina las variables DB_*.
#     Elastic Beanstalk inyecta RDS_HOSTNAME / RDS_PORT / RDS_DB_NAME /
#     RDS_USERNAME / RDS_PASSWORD y la aplicacion las lee automaticamente.
#   * Base de datos INDEPENDIENTE -> defina las DB_* en la consola, en
#     Configuration > Updates, monitoring and logging > Environment properties.
#   * STATIC_TOKEN y JWT_SECRET_KEY siempre van en Environment properties.
# ---------------------------------------------------------------------------

# Entorno de ejecucion: development | production | testing
APP_ENV=development

# --- Base de datos -----------------------------------------------------------
# Opcion A: cadena de conexion completa (tiene prioridad sobre las piezas)
# DATABASE_URL=postgresql+psycopg2://usuario:password@host:5432/blacklistdb

# Opcion B: piezas individuales (recomendado en Elastic Beanstalk)
DB_ENGINE=postgresql
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=blacklistdb

# --- Seguridad ---------------------------------------------------------------
# Token estatico (Bearer) aceptado por la API. Cambielo antes de desplegar.
STATIC_TOKEN=devopskings-2026-token-listanegra

# Llave para firmar/verificar JWT emitidos por POST /auth/token
JWT_SECRET_KEY=cambie-esta-llave-por-una-aleatoria-y-larga

# Minutos de vigencia de los JWT emitidos
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60
