###############################################################################
# Grupo de Auto Scaling.
#
# El documento de la entrega pide ejecutar 4 estrategias de despliegue que
# requieran mas de una instancia, y recomienda un ASG de minimo 3 y maximo 6.
#
# NOTA: la estrategia de despliegue (all-at-once, rolling, rolling with
# additional batch, immutable, traffic-splitting) NO se fija aqui a proposito.
# Se cambia desde la consola de AWS antes de cada despliegue, para poder tomar
# las capturas de pantalla que exige el entregable. Si se definiera en
# .ebextensions, cada despliegue sobrescribiria lo configurado en consola.
###############################################################################

option_settings:
  aws:autoscaling:asg:
    MinSize: "3"
    MaxSize: "6"

  aws:autoscaling:launchconfiguration:
    InstanceType: t3.micro

  # Disparadores de escalado basados en CPU.
  aws:autoscaling:trigger:
    MeasureName: CPUUtilization
    Statistic: Average
    Unit: Percent
    UpperThreshold: "70"
    LowerThreshold: "30"
    BreachDuration: "5"
    Period: "5"
