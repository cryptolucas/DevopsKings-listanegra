###############################################################################
# Configuracion base de la aplicacion en AWS Elastic Beanstalk.
#
# IMPORTANTE: aqui NO se ponen credenciales. Las variables sensibles
# (DB_PASSWORD, STATIC_TOKEN, JWT_SECRET_KEY) se definen en la consola:
#   Environment > Configuration > Updates, monitoring and logging
#     > Environment properties
###############################################################################

option_settings:
  # --- Punto de entrada WSGI -------------------------------------------------
  # En Amazon Linux 2/2023 el Procfile manda sobre esta opcion: la plataforma
  # ejecuta el comando gunicorn del Procfile. WSGIPath se deja declarado por
  # claridad y como respaldo si el Procfile no viaja en el bundle.
  aws:elasticbeanstalk:container:python:
    WSGIPath: application:application

  # --- Variables de entorno no sensibles ------------------------------------
  # No se declaran DB_HOST / DB_PORT / DB_NAME / DB_USER / DB_PASSWORD a
  # proposito:
  #   * Base ACOPLADA al ambiente -> Elastic Beanstalk inyecta RDS_HOSTNAME,
  #     RDS_PORT, RDS_DB_NAME, RDS_USERNAME y RDS_PASSWORD, que src/config.py
  #     ya reconoce. No hay que configurar nada mas.
  #   * Base INDEPENDIENTE -> se definen las DB_* como Environment properties
  #     en la consola (ahi viven las credenciales, nunca en este archivo).
  aws:elasticbeanstalk:application:environment:
    APP_ENV: production
    PYTHONPATH: "/var/app/current:$PYTHONPATH"
    PYTHONUNBUFFERED: "1"
    AUTO_CREATE_TABLES: "true"

  # --- Health check del balanceador -----------------------------------------
  # El ELB consulta GET /health. Ese endpoint no exige Bearer Token y verifica
  # tambien la conectividad con la base de datos (SELECT 1).
  aws:elasticbeanstalk:environment:process:default:
    HealthCheckPath: /health
    HealthCheckInterval: 15
    HealthCheckTimeout: 5
    HealthyThresholdCount: 3
    UnhealthyThresholdCount: 5
    MatcherHTTPCode: "200"
    Port: "80"
    Protocol: HTTP

  # --- Health reporting mejorado (requisito del documento) ------------------
  aws:elasticbeanstalk:healthreporting:system:
    SystemType: enhanced
